---
title: 戒色打卡
date: 2026-05-04 17:00:00
type: checkin
layout: page
aside: false
comments: true
top_img: /img/comment_bg.png
---

<style>
#body-wrap.page .layout { background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; max-width: 1250px !important; }
#page { background: transparent !important; border: none !important; box-shadow: none !important; margin: 0 !important; padding: 0 !important; }
.page-title { display: none; }

:root { --m-c: #3b82f6; --f-c: #fb7185; --t-c: #4f46e5; }

#checkin-dashboard { display: flex; flex-direction: column; gap: 12px; padding: 10px; animation: fadeIn 0.5s ease; }

.ci-banner { 
    height: 240px; border-radius: 24px; background-size: cover; background-position: center; 
    margin-bottom: 5px; overflow: hidden; position: relative;
    background-image: url('<%- page.top_img %>');
}
.ci-banner-mask { width: 100%; height: 100%; background: linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 100%); display: flex; align-items: center; padding: 0 50px; }
.ci-badge { color: #818cf8; font-weight: bold; font-size: 0.85rem; letter-spacing: 3px; opacity: 0.8; }
.ci-title { color: white; font-size: 2.8rem; margin: 10px 0; font-weight: 900; text-shadow: 0 2px 15px rgba(0,0,0,0.5); }
.ci-desc { color: rgba(255,255,255,0.7); font-size: 0.95rem; min-height: 1.5em; transition: opacity 0.5s ease; }

.db-main { display: grid; grid-template-columns: 30% 38% 30%; gap: 15px; height: 460px; }
.db-card { background: var(--card-bg); border: var(--style-border); border-radius: 16px; padding: 15px; box-shadow: var(--anzhiyu-shadow-border); overflow: hidden; display: flex; flex-direction: column; height: 100%; }

.db-left { display: flex; flex-direction: column; gap: 12px; }
.act-card { flex: 0 0 38%; background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white; border: none; padding: 15px 20px; justify-content: space-around; }
.stat-card { flex: 1; justify-content: space-around; }

.date-row { font-size: 1.8rem; font-weight: 900; line-height: 1; }
.g-btn { padding: 5px 12px; border-radius: 8px; background: rgba(255,255,255,0.15); font-weight: bold; font-size: 0.8rem; cursor: pointer; }
.g-pick input { display: none; }
.g-pick input:checked + .m { background: var(--m-c); }
.g-pick input:checked + .f { background: var(--f-c); }
#do-btn { width: 100%; padding: 10px; border-radius: 12px; border: none; background: white; color: var(--t-c); font-weight: 900; cursor: pointer; font-size: 0.9rem; }

.db-mid { justify-content: flex-start; padding: 15px 20px; }
.cal-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-weight: bold; font-size: 0.9rem; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; flex: 1; align-content: flex-start; } 
.cal-d { aspect-ratio: 1; border-radius: 6px; background: var(--anzhiyu-secondbg); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; cursor: pointer; border: 1.5px solid transparent; }
.cal-d.sel { border-color: var(--t-c) !important; transform: scale(1.05); }

.stream-wall { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0; scrollbar-width: none; }
.stream-wall::-webkit-scrollbar { display: none; }
.barrage-item { display: flex; gap: 10px; padding: 8px 5px; border-bottom: 1px dashed var(--hr-border); animation: fadeIn 0.4s ease backwards; align-items: flex-start; }
.bi-avatar { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; flex-shrink: 0; margin-top: 2px; }
.bi-body { flex: 1; overflow: hidden; }
.bi-head { display: flex; align-items: center; gap: 5px; margin-bottom: 2px; }
.bi-nick { font-weight: 800; font-size: 0.8rem; color: var(--anzhiyu-fontcolor); }
.bi-tag { font-size: 9px; padding: 0 4px; border-radius: 3px; font-weight: 900; color: white; }
.tag-m { background: var(--m-c); }
.tag-f { background: var(--f-c); }
.bi-content { font-size: 0.75rem; opacity: 0.7; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bi-content p { margin: 0 !important; display: inline !important; }

.s-title { font-weight: 900; font-size: 0.95rem; margin-bottom: 5px; border-bottom: 1px dashed var(--hr-border); padding-bottom: 8px; }
.s-line { display: flex; justify-content: space-between; font-size: 0.85rem; }
.clash-bar { height: 7px; border-radius: 3.5px; overflow: hidden; display: flex; margin-top: 5px; }

@keyframes fadeIn { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: translateX(0); } }
@media (max-width: 1000px) { .db-main { grid-template-columns: 1fr; height: auto; } }
</style>

<div id="checkin-dashboard">
    <div class="ci-banner"><div class="ci-banner-mask"><div class="ci-banner-inner">
        <span class="ci-badge">FOR BETTER SELF</span>
        <h1 class="ci-title">戒色打卡！</h1>
        <p class="ci-desc" id="ci-slogan">戒色先戒心，心定则色不扰。</p>
    </div></div></div>

    <div class="db-main">
        <div class="db-left">
            <div class="db-card act-card">
                <div class="date-row" id="d-str">5月4日</div>
                <div class="g-pick" style="display:flex; gap:10px;">
                    <label style="flex:1"><input type="radio" name="gender" value="男" checked><span class="g-btn m">♂ 机长</span></label>
                    <label style="flex:1"><input type="radio" name="gender" value="女"><span class="g-btn f">♀ 矿长</span></label>
                </div>
                <button id="do-btn" onclick="doCheckin()">⚡ 立即打卡</button>
            </div>
            <div class="db-card stat-card">
                <div class="s-title" id="s-t">今日数据看板</div>
                <div class="s-line"><span>总人数</span><span id="tot-v">0</span></div>
                <div class="s-line"><span>机长</span><span id="m-v" style="color:var(--m-c)">0</span></div>
                <div class="s-line"><span>矿长</span><span id="f-v" style="color:var(--f-c)">0</span></div>
                <div class="clash-bar"><div id="c-m" class="clash-m"></div><div id="c-f" class="clash-f"></div></div>
                <div id="b-td" onclick="viewDate(new Date().toISOString().split('T')[0])" style="display:none; font-size:10px; text-align:center; margin-top:10px; cursor:pointer; opacity:0.6;">返回今日</div>
            </div>
        </div>

        <div class="db-card db-mid">
            <div class="cal-nav">
                <span style="cursor:pointer;opacity:0.4" onclick="chM(-1)">❮</span>
                <span id="cal-t">2026年 5月</span>
                <span style="cursor:pointer;opacity:0.4" onclick="chM(1)">❯</span>
            </div>
            <div class="cal-grid" style="text-align:center; font-size:0.75rem; opacity:0.4; margin-bottom:10px;">
                <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
            </div>
            <div id="cal-d-g" class="cal-grid"></div>
        </div>

        <div class="db-card db-right">
            <div class="s-title" id="wall-t">🌊 实时动态</div>
            <div id="wall" class="stream-wall"></div>
        </div>
    </div>
</div>

<script>
const E = 'https://muytecbolgcomments.vercel.app/';
let cY = new Date().getFullYear(), cM = new Date().getMonth();
let cache = {}, all = [];

const slogans = [
    "戒色先戒心，心定则色不扰。",
    "每一个不曾起舞的日子，都是对生命的辜负。",
    "自律即自由，坚持成就更好的自己。",
    "少年强则国强，少年精则气足。",
    "欲火焚身，莫如心如止水。",
    "知足常乐，清心寡欲。",
    "志存高远，不溺儿女私情。"
];
let sloganIdx = 0;
function rotateSlogan() {
    const el = document.getElementById('ci-slogan');
    if(!el) return;
    el.style.opacity = '0';
    setTimeout(() => {
        sloganIdx = (sloganIdx + 1) % slogans.length;
        el.innerText = slogans[sloganIdx];
        el.style.opacity = '1';
    }, 500);
}
setInterval(rotateSlogan, 6000);

async function init() {
    try {
        const r = await fetch(E, { method: 'POST', body: JSON.stringify({ event: 'GET_RECENT_COMMENTS', pageSize: 400 }), headers: { 'Content-Type': 'application/json' } });
        const res = await r.json();
        const raw = res.data || [];
        all = raw.filter(c => c.comment.includes('@打卡'));
        cache = process(all);
        viewDate(new Date().toISOString().split('T')[0]);
        renderCal();
    } catch (e) {}
}

function process(list) {
    const s = {}; list.forEach(c => {
        const d = new Date(c.created).toISOString().split('T')[0];
        if (!s[d]) s[d] = { m: 0, f: 0 };
        if (c.comment.includes('#女')) s[d].f++; else s[d].m++;
    }); return s;
}

function renderWallByDate(ds) {
    const w = document.getElementById('wall'); if(!w) return;
    w.innerHTML = '';
    const today = new Date().toISOString().split('T')[0];
    const isToday = ds === today;
    document.getElementById('wall-t').innerText = isToday ? '🌊 实时动态' : ds.slice(5) + ' 动态';
    const filtered = all.filter(c => new Date(c.created).toISOString().split('T')[0] === ds);
    if (filtered.length === 0) {
        w.innerHTML = `<div class="empty-tip" style="text-align:center;opacity:0.4;padding:80px 20px;font-size:0.8rem;font-style:italic;">${isToday ? '今日导师们有些许放纵了' : '这天导师们貌似都在休整'}</div>`;
        return;
    }
    filtered.slice(0, 40).forEach(c => {
        const isF = c.comment.includes('#女');
        const item = document.createElement('div');
        item.className = 'barrage-item';
        const avatar = c.avatar || 'https://cravatar.cn/avatar/default?s=64';
        const time = new Date(c.created), timeStr = `${String(time.getHours()).padStart(2,'0')}:${String(time.getMinutes()).padStart(2,'0')}`;
        item.innerHTML = `<img class="bi-avatar" src="${avatar}"><div class="bi-body"><div class="bi-head"><span class="bi-nick">${c.nick}</span><span class="bi-tag ${isF?'tag-f':'tag-m'}">${isF?'矿长':'机长'}</span><span class="mc-time" style="font-size:9px;opacity:0.2;margin-left:auto;">${timeStr}</span></div><div class="bi-content">${c.comment.replace(/@打卡#(男|女)/g,'').trim() || '打卡'}</div></div>`;
        w.appendChild(item);
    });
}

function viewDate(ds) {
    const d = cache[ds] || { m: 0, f: 0 }, today = new Date().toISOString().split('T')[0], isT = ds === today;
    const stEl = document.getElementById('s-t'); if(!stEl) return;
    stEl.innerText = isT ? '今日数据看板' : ds.slice(5) + ' 统计';
    document.getElementById('tot-v').innerText = d.m + d.f;
    document.getElementById('m-v').innerText = d.m;
    document.getElementById('f-v').innerText = d.f;
    const tot = d.m + d.f;
    document.getElementById('c-m').style.width = tot > 0 ? (d.m/tot*100)+'%' : '50%';
    document.getElementById('c-f').style.width = tot > 0 ? (d.f/tot*100)+'%' : '50%';
    document.getElementById('b-td').style.display = isT ? 'none' : 'block';
    document.querySelectorAll('.cal-d').forEach(el => el.classList.toggle('sel', el.getAttribute('data-d') === ds));
    renderWallByDate(ds);
}

function renderCal() {
    document.getElementById('cal-t').innerText = `${cY}年 ${cM + 1}月`;
    const days = new Date(cY, cM + 1, 0).getDate(), first = new Date(cY, cM, 1).getDay(), today = new Date().toISOString().split('T')[0];
    const box = document.getElementById('cal-d-g'); if(!box) return;
    box.innerHTML = '';
    for (let i = 0; i < first; i++) box.innerHTML += '<div class="cal-d" style="background:transparent;cursor:default;"></div>';
    for (let d = 1; d <= days; d++) {
        const ds = `${cY}-${String(cM+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`, data = cache[ds];
        let style = ''; if (data) { const tot = data.m + data.f, mP = (data.m/tot*100); style = `style="background:linear-gradient(to right, var(--m-c) ${mP}%, var(--f-c) ${mP}%); color:white; border:none;"`; }
        box.innerHTML += `<div class="cal-d ${ds===today?'sel':''}" ${style} data-d="${ds}" onclick="viewDate('${ds}')">${d}</div>`;
    }
}

function chM(step) { cM += step; if (cM < 0) { cM = 11; cY--; } else if (cM > 11) { cM = 0; cY++; } renderCal(); }

function doCheckin() {
    const g = document.querySelector('input[name="gender"]:checked').value, inp = document.querySelector('.el-textarea__inner') || document.querySelector('.tk-input');
    if (inp) { inp.value = `@打卡#${g} `; inp.dispatchEvent(new Event('input', { bubbles: true })); inp.focus(); if (window.anzhiyu) anzhiyu.snackbarShow(`已为您准备好打卡标签！`); }
}

document.getElementById('d-str').innerText = `${new Date().getMonth()+1}月${new Date().getDate()}日`;
init();
</script>
